# Kopiera till .env. src/config.ts är den ENDA modulen som läser process.env
# (undantag: migrations-CLI:t och skapaNyckel-skriptet, som inte får kräva
# app-rollens konfiguration). Servern vägrar starta med ofullständig config.

# Appen ansluter som den lågprivilegierade rollen `app` (icke-superuser).
DATABASE_URL=postgres://app@127.0.0.1:5435/arenden

# Ägarrollen — används ENBART av `npm run migrate`.
DATABASE_ADMIN_URL=postgres://postgres@127.0.0.1:5435/arenden

# HTTP-servern binds till 127.0.0.1 (ingen extern yta i Etapp 1).
HOST=127.0.0.1
PORT=3002
RATE_LIMIT_PER_MINUTE=120

# Adaptern (src/adapter/) ringer actions-API:t över HTTP med bearer-nyckel.
# Nyckeln skapas med: npm run nyckel -- agent hermes
ARENDEN_API_URL=http://127.0.0.1:3002
ARENDEN_API_KEY=
